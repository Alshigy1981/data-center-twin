# Server configuration
BACKEND_URL=http://localhost:8000
PORT=8000

# Database
DATABASE_PATH=./data/dc_twin.db

# Weather API (Open-Meteo — no key needed)
OPEN_METEO_ENABLED=true
LOCATION_LAT=41.8827
LOCATION_LON=-87.6233
LOCATION_NAME=Chicago, IL
WEATHER_CACHE_TTL=900
CLOUD_API_TIMEOUT_SECONDS=5

# Optional API keys (leave empty to use simulated data)
ELECTRICITY_MAPS_ENABLED=false
ELECTRICITY_MAPS_API_KEY=
EIA_ENABLED=false
EIA_API_KEY=
EIA_REGION=MIDW
GRID_REGION=US-MIDW

# Carbon intensity
CARBON_INTENSITY_KG_PER_KWH=0.233

# Simulation settings
SIMULATION_INTERVAL_SECONDS=5
ANOMALY_INJECTION_RATE=0.05
